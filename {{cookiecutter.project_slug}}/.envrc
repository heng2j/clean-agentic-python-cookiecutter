# This reviewed file is executable after `direnv allow`; keep it side-effect-light.
# Secret loading is opt-in because every child process and coding agent inherits it.
watch_file .env
# dotenv_if_exists .env

if [[ -d "$PWD/.venv/bin" ]]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$VIRTUAL_ENV/bin"
fi
